# Existing website
NEXT_PUBLIC_SITE_URL=http://localhost:3001
NEXT_PUBLIC_MAINTENANCE_MODE=false

# MongoDB tracking portal (never expose MONGODB_URI with NEXT_PUBLIC_)
MONGODB_URI=mongodb://127.0.0.1:27017/clearance_tracker
TRACKING_PORT=4000
CLIENT_ORIGIN=http://localhost:3001,http://127.0.0.1:3001
NEXT_PUBLIC_TRACKING_API_URL=http://localhost:4000/api

# Legacy CMS only — optional while content is still stored in Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
